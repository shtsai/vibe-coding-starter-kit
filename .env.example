# Copy this file to .env.local and fill it in. .env.local is gitignored and must
# NEVER be committed. Never paste a real value into a chat window.

# Your own development database — a Neon branch, not production.
DATABASE_URL=

# Production. Only used by `npm run db:deploy-production` and the pre-flight check.
# Nothing in the app reads this.
PRODUCTION_DATABASE_URL=

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=
